{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "global": {
      "type": "object",
      "required": [
        "crowlerVersion",
        "vdiVersion",
        "imagePullPolicy",
        "timezone"
      ],
      "properties": {
        "crowlerVersion": {
          "type": "string",
          "minLength": 1
        },
        "vdiVersion": {
          "type": "string",
          "minLength": 1
        },
        "imagePullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "config": {
      "type": "object",
      "required": [
        "create",
        "existingConfigMap",
        "content",
        "rolloutToken"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "existingConfigMap": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "rolloutToken": {
          "type": "string"
        }
      }
    },
    "secrets": {
      "type": "object",
      "required": [
        "create",
        "existingSecret",
        "rolloutToken",
        "data"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string"
        },
        "rolloutToken": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {
            "postgresPassword": {
              "type": "string"
            },
            "crowlerDbUser": {
              "type": "string",
              "minLength": 1
            },
            "crowlerDbPassword": {
              "type": "string"
            },
            "seleniumPassword": {
              "type": "string"
            }
          }
        }
      }
    },
    "userContent": {
      "type": "object",
      "required": [
        "enabled",
        "agentsConfigMap",
        "pluginsConfigMap",
        "rulesConfigMap",
        "supportConfigMap",
        "rolloutToken"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "agentsConfigMap": {
          "type": "string"
        },
        "pluginsConfigMap": {
          "type": "string"
        },
        "rulesConfigMap": {
          "type": "string"
        },
        "supportConfigMap": {
          "type": "string"
        },
        "rolloutToken": {
          "type": "string"
        }
      }
    },
    "database": {
      "type": "object",
      "required": [
        "enabled",
        "host",
        "port",
        "name",
        "sslMode"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sslMode": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "events": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "engine": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "vdi": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "jaeger": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "pushgateway": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
